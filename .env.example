# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# Chat: gpt-4o-mini. Chọn đường gọi bằng CHAT_PROVIDER, chỉ cần điền key của
# nhánh mình dùng. KHÔNG thêm tiền tố "openai/" vào CHAT_MODEL — llm.py tự
# thêm cho nhánh openrouter, còn API của OpenAI trả 400 nếu có tiền tố đó.
#
#   openai     -> gọi thẳng OpenAI, đúng stack BTC nêu (mặc định)
#   openrouter -> proxy tương thích OpenAI, dùng khi không có key OpenAI
CHAT_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-key-here
# OPEN_ROUTER_API_KEY=sk-or-v1-your-key-here
# CHAT_MODEL=gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Nhiệt độ + giới hạn cho MỌI lời gọi LLM. 600 token đã đủ cho câu trả lời
# tiếng Việt — giữ nguyên để hoá đơn không phụ thuộc việc model có nói dài hay không.
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_TOKENS=600

# Embeddings: OpenRouter không có endpoint embeddings, dùng Google
# Generative AI riêng (model gemini-embedding-001) cho bước này.
GOOGLE_API_KEY=your-google-ai-studio-key-here
# EMBEDDING_MODEL=models/gemini-embedding-001

# ---- Database ----
# Supabase → Project Settings → Database → Connection string → chọn tab
# "Session pooler". KHÔNG dùng "Direct connection" (chỉ IPv6, mạng IPv4 sẽ
# treo) và KHÔNG dùng "Transaction pooler" cổng 6543 (Alembic sẽ lỗi).
# Dạng đúng — chú ý user là postgres.<project-ref>, không phải postgres:
DATABASE_URL=postgresql://postgres.abcdefghijklm:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Dev không cần Supabase:
# DATABASE_URL=sqlite:///./data/app.db

# ---- Supabase Auth (US-01) ----
# Project Settings → API. SERVICE_KEY bỏ qua toàn bộ Row Level Security —
# chỉ để ở backend, không đưa sang frontend.
SUPABASE_URL=https://abcdefghijklm.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ---- Lưu trữ ảnh minh chứng (US-13) ----
# Bucket PRIVATE trên Supabase Storage — CCCD/VNeID không bao giờ được có URL
# công khai, chỉ đọc qua signed URL hết hạn ngắn do backend ký.
# SUPABASE_STORAGE_BUCKET=application-attachments
# ATTACHMENT_URL_TTL_SECONDS=300
# ATTACHMENT_MAX_BYTES=5242880

# ---- Vector Store / RAG ----
CHROMA_PERSIST_DIR=./data/chroma
# Top-k chunk lấy về mỗi câu hỏi.
# RAG_TOP_K=4
# Ngưỡng cosine distance (0 = giống hệt, ~1 = không liên quan) — chunk gần
# nhất phải dưới ngưỡng này mới coi là có context. Hiệu chỉnh sơ bộ 10/08
# bằng 4 câu hỏi thật (xem src/config.py) — vẫn cần bộ 10 câu đầy đủ hơn,
# xem docs/architecture_diagram.md mục 3.5.
# RAG_MAX_DISTANCE=0.35
# Số lượt hỏi-đáp gần nhất (cùng hội thoại) đưa vào node rewrite_query để viết
# lại câu hỏi mơ hồ ("còn phí thì sao?") thành độc lập ngữ cảnh — multi-turn.
# RAG_HISTORY_TURNS=3

# ---- Giới hạn tốc độ (rate limiting) ----
# Chặn burst theo IP trên endpoint tốn tiền: /chat, tải tệp, nạp tài liệu.
# KHÔNG có trần tổng số request/ngày ở đây — xem README mục "Giới hạn tốc độ".
# CHAT_RATE_LIMIT_PER_MINUTE=10
# CHAT_RATE_LIMIT_PER_HOUR=100
# UPLOAD_RATE_LIMIT_PER_MINUTE=20

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
# Để `false` khi làm việc thường ngày: bật là mỗi lượt chat gửi prompt và câu
# hỏi của cư dân sang dịch vụ ngoài. Bật khi cần cho mentor xem trace.
# Thiếu LANGCHAIN_API_KEY thì `src/services/tracing.py` tự tắt và ghi cảnh báo,
# không làm hỏng chat.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=moveinmate
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Quan sát & cảnh báo ----
# Không đặt thì ngưỡng vẫn được kiểm, chỉ ghi cảnh báo vào log thay vì gửi Slack.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# ALERT_COST_DAILY_THRESHOLD=10.0

# Khoá bảo vệ GET /api/v1/metrics (endpoint phơi lưu lượng, tỉ lệ lỗi, chi phí).
# RỖNG = không kiểm — tiện cho máy dev. BẮT BUỘC đặt khi APP_ENV=production,
# nếu không ai biết địa chỉ đều đọc được số liệu vận hành.
# Sinh khoá:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Đặt xong nhớ khai cùng giá trị ở phần `authorization` trong prometheus.yml.
# METRICS_TOKEN=

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
